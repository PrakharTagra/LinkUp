# ── LinkUp Backend Environment Configuration ──
PORT=5000
NODE_ENV=production

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/linkup?retryWrites=true&w=majority

# Security
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app

# Unified ML Service URL (Career Path + Skill Gap)
ML_SERVICE_URL=https://linkup-ml.onrender.com
SKILL_GAP_SERVICE_URL=https://linkup-ml.onrender.com

# AI Assistant (Groq Cloud LLM)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloudinary Media Storage (Optional for profile photos and video posts)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Render Keep-Alive (Render sets RENDER_EXTERNAL_URL automatically, or set manually)
# KEEP_ALIVE_URL=https://linkup-backend.onrender.com

# ── LinkUp Unified ML Service Configuration ──
PORT=8001

# Optional: MongoDB connection for live course & alumni recommendations in Skill Gap
# If omitted or USE_MOCK_DATA=true, it uses built-in datasets and mock portal data smoothly
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/linkup?retryWrites=true&w=majority
DB_NAME=test
USE_MOCK_DATA=true

# Render Keep-Alive (Render sets RENDER_EXTERNAL_URL automatically, or set manually)
# KEEP_ALIVE_URL=https://linkup-ml.onrender.com

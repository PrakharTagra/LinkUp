# ── LinkUp Frontend Environment Configuration ──

# Main Backend API URL (where auth, users, posts, chat are hosted)
VITE_API_URL=https://linkup-backend.onrender.com

# AI Chat API URL (defaults to VITE_API_URL since AI chat is unified into the backend)
VITE_AI_API_URL=https://linkup-backend.onrender.com

# Unified ML Service URL (Career Path predictor & ML features)
VITE_ML_API_URL=https://linkup-ml.onrender.com

# Optional Google OAuth Client ID
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
